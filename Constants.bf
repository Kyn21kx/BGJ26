namespace Hush;

static class Constants
{
	public const float EPSILON = 0.000001f;
	public const float PI =  3.14159f;
	public const float EULER = 2.71828f;
	public const float GOLDEN_RATIO = 1.61803f;

	public const Vector3  Vector3_ZERO	  = Vector3(0.0f, 0.0f, 0.0f);
	public const Vector3  Vector3_ONE 	  = Vector3(1.0f, 1.0f, 1.0f);
	public const Vector3  Vector3_UNIT_X  = Vector3(1.0f, 0.0f, 0.0f);
	public const Vector3  Vector3_UNIT_Y  = Vector3(0.0f, 1.0f, 0.0f);
	public const Vector3  Vector3_UNIY_Z  = Vector3(0.0f, 0.0f, 1.0f);

	public const Vector2  Vector2_ZERO 	  = Vector2(0.0f, 0.0f);
	public const Vector2  Vector2_ONE 	  = Vector2(1.0f, 1.0f);
	public const Vector2  Vector2_UNIT_X  = Vector2(1.0f, 0.0f);
	public const Vector2  Vector2_UNIT_Y  = Vector2(0.0f, 1.0f);
	public const Vector2  Vector2_UNIY_Z  = Vector2(0.0f, 0.0f);

}